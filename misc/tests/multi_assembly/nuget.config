<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to both fixture/ and external/ (NuGet walks up the directory tree).
  ".feed" is populated by verify.py with the fork packages under test plus the
  freshly packed fixture modules.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="fork" value=".feed" />
  </packageSources>
  <packageSourceMapping>
    <!-- The fork packages must never resolve to upstream's: upstream's source
         generator emits res://../X.cs for assembly-backed scripts, which is the
         exact regression this test exists to catch. -->
    <packageSource key="fork">
      <package pattern="CrackTower.Godot.*" />
      <package pattern="ExternalModule" />
      <package pattern="TransitiveModule" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
